{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/v25.10.0/themes/schema.json",
  "version": 3,
  "final_space": true,
  "console_title_template": "{{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "background": "#2D5D8F",
          "foreground": "#FBF3E2",
          "properties": {
            "windows": "\ue70f"
          },
          "template": " {{ .Icon }} "
        },
        {
          "type": "session",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "background": "#16233C",
          "foreground": "#EDE0C8",
          "template": " \uf007 {{ .UserName }}<#5B8FCC>@{{ .HostName }}</> "
        },
        {
          "type": "path",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "background": "#16233C",
          "foreground": "#EDE0C8",
          "properties": {
            "style": "full"
          },
          "template": " <#D4A537>\uf07b</> {{ .Path }} "
        },
        {
          "type": "git",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "background": "#16233C",
          "foreground": "#F0C75E",
          "foreground_templates": [
            "{{ if gt .Behind 0 }}#E06A5E{{ end }}"
          ],
          "properties": {
            "fetch_status": true,
            "branch_icon": ""
          },
          "template": " <#E0A03C>\ue725</> {{ .HEAD }}{{ if or (.Working.Changed) (.Staging.Changed) }} <#D4A537>\uf111</>{{ end }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#8A93A8",
          "properties": {
            "threshold": 500,
            "style": "austin"
          },
          "template": "{{ .FormattedMs }} "
        },
        {
          "type": "time",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "background": "#16233C",
          "foreground": "#8A93A8",
          "properties": {
            "time_format": "3:04 PM"
          },
          "template": " \uf017 {{ .CurrentDate | date .Format }} "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#D4A537",
          "template": " \u06de"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "#D4A537",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#C0453C{{ end }}"
          ],
          "properties": {
            "always_enabled": true
          },
          "template": "\u276f"
        }
      ]
    }
  ],
  "transient_prompt": {
    "foreground": "#D4A537",
    "background": "transparent",
    "template": "\u06de "
  },
  "secondary_prompt": {
    "foreground": "#8A93A8",
    "background": "transparent",
    "template": "\u276f\u276f "
  }
}
